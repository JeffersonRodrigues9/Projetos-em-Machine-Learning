      "source": [
        "# 1. Carregando os Dados do Banco\n",
        "import pandas as pd\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "\n",
        "# 1. Lendo o arquivo CSV\n",
        "tabela_banco = pd.read_csv('historico_credito_100_clientes.csv')\n",
        "\n",
        "print(\"Visualizando os primeiros 5 clientes da base de dados:\\n\")\n",
        "print(tabela_banco.head())  # use print se não estiver no Jupyter\n",
        "\n",
        "# 2. Separando X (Características) e y (Alvo)\n",
        "X = tabela_banco[['Idade', 'Salario', 'Divida_Atual']]\n",
        "y = tabela_banco['Risco_Alto']\n",
        "\n",
        "# 3. Normalizando os dados (OBRIGATÓRIO para Redes Neurais)\n",
        "normalizador = StandardScaler()\n",
        "X_normalizado = normalizador.fit_transform(X)\n",
        "\n",
        "# 4. Separando Treino e Teste (Regra de Ouro)\n",
        "X_treino, X_teste, y_treino, y_teste = train_test_split(\n",
        "    X_normalizado, y, test_size=0.2, random_state=42\n",
        ")\n",
        "\n",
        "print('\\nBase com 100 clientes pronta e normalizada para redes neurais!')"
      ],
