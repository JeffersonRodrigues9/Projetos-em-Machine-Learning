        "# 2. Construindo a Arquitetura de Rede Neural Artificial (O Célebro)\n",
        "import tensorflow as tf\n",
        "from tensorflow import keras\n",
        "\n",
        "# 1. Inicializando a Rede Neural Sequencial (camadas em sequência)\n",
        "modelo_rn = keras.Sequential([\n",
        "    # Temos 3 Informações de entrada: Idade, Salário e dívida Atual\n",
        "    keras.Input(shape=(3,)),\n",
        "\n",
        "    # 1ª Camada Oculta (Quantidade de Neurônios)\n",
        "    keras.layers.Dense(4, activation='relu'),\n",
        "\n",
        "    # Camada de Saída (O nosso espremedor de probabilidade: 0 a 1)\n",
        "    keras.layers.Dense(1, activation='sigmoid')\n",
        "])\n",
        "\n",
        "# 2. Compilando o cérebro (Definindo as regras de estudo)\n",
        "modelo_rn.compile(optimizer='adam', loss='binary_crossentropy', metrics=['accuracy'])\n",
        "\n",
        "print('Cérebro digital construído com sucesso! Veja o resumo abaixo:')\n",
        "modelo_rn.summary()"
